# =====================================================================
# TELEGRAM
# =====================================================================

BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID основателя бота.
# Можно указать несколько ID через запятую, если архитектура
# проекта это поддерживает.
FOUNDER_IDS=123456789


# =====================================================================
# DATABASE
# =====================================================================

# Локальная SQLite база для разработки.
#
# Для текущего запуска на Windows:
#
# sqlite+aiosqlite:///./bot.db
#
# Позже для VDS/PostgreSQL значение можно будет заменить,
# не меняя архитектуру приложения.

DATABASE_URL=sqlite+aiosqlite:///./bot.db


# =====================================================================
# APPLICATION
# =====================================================================

DEBUG=true