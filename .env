BOT_TOKEN=сюда_токен_бота
FOUNDER_ID=123456789

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telegram_rpg_bot

DATABASE_ECHO=false

APP_NAME=Telegram RPG Bot
ENVIRONMENT=development
DEBUG=true

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

DEFAULT_TIMEZONE=Europe/Warsaw

DEFAULT_MESSAGE_REWARD=1
DEFAULT_PHOTO_REWARD=3
DEFAULT_VIDEO_REWARD=5
DEFAULT_MESSAGE_COOLDOWN=10

ANTIFLOOD_ENABLED=true
ANTIFLOOD_MESSAGES=5
ANTIFLOOD_INTERVAL=10
ANTIFLOOD_MUTE_SECONDS=60

HOURLY_REWARD_ENABLED=true
HOURLY_REWARD_AMOUNT=100

PASSIVE_INCOME_REQUIRED_MESSAGES=30

FOUNDER_PANEL_ENABLED=true
DROP_PENDING_UPDATES=true